{
  "name": "acd",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "schema:validate": "pnpm --filter @acd/schema schema:validate",
    "schema:generate": "pnpm --filter @acd/schema schema:generate",
    "schema:check": "pnpm --filter @acd/schema schema:check",
    "golden": "vitest run fixtures packages",
    "kicad:spike": "bash scripts/kicad-spike.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@types/node": "22.15.21",
    "@typescript-eslint/eslint-plugin": "8.35.1",
    "@typescript-eslint/parser": "8.35.1",
    "eslint": "9.30.1",
    "prettier": "3.6.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vitest": "3.2.4"
  }
}
