{
  "name": "acd",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "license:check": "node scripts/check-licenses.mjs",
    "format:check": "prettier --check . --ignore-unknown",
    "schema:validate": "pnpm --filter @acd/schema schema:validate",
    "schema:generate": "pnpm --filter @acd/schema schema:generate",
    "schema:check": "pnpm --filter @acd/schema schema:check",
    "typegen-sync": "pnpm --filter @acd/schema schema:check",
    "golden": "tsx scripts/golden-run.mts",
    "golden:unit": "vitest run fixtures packages",
    "kicad:spike": "bash scripts/kicad-spike.sh",
    "kicad:library:verify": "tsx scripts/verify-kicad-library.mts",
    "phase1:smoke": "pnpm kicad:library:verify && pnpm --filter @acd/adapter-kicad build && tsx scripts/phase1-smoke.mts",
    "phase1:golden": "pnpm kicad:library:verify && pnpm --filter @acd/adapter-kicad build && tsx scripts/phase1-golden.mts",
    "phase1:gate13": "tsx scripts/phase1-gate13.mts"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@types/node": "22.15.21",
    "@typescript-eslint/eslint-plugin": "8.35.1",
    "@typescript-eslint/parser": "8.35.1",
    "eslint": "9.30.1",
    "prettier": "3.6.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vitest": "3.2.4"
  }
}
