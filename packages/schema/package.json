{
  "name": "@acd/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "schema:validate": "tsx src/validate-samples.ts",
    "schema:generate": "tsx src/generate-types.ts",
    "schema:check": "pnpm schema:generate && git diff --exit-code -- src/generated",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
