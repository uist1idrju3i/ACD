{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acd.example.invalid/schemas/physical-evidence.schema.json",
  "title": "ACD Phase 1 Physical Evidence",
  "type": "object",
  "required": [
    "id",
    "revision",
    "kind",
    "status",
    "board",
    "assembly",
    "instruments",
    "testItems",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^evidence:[A-Za-z0-9._:-]+$" },
    "revision": { "type": "integer", "minimum": 0 },
    "kind": { "const": "physical-measurement" },
    "status": { "enum": ["passed", "failed", "pending"] },
    "board": {
      "type": "object",
      "required": ["projectId", "graphRevision", "boardRevision", "pcbArtifactHash"],
      "additionalProperties": false,
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "graphRevision": { "type": "integer", "minimum": 0 },
        "boardRevision": { "type": "string", "minLength": 1 },
        "pcbArtifactHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "bomArtifactHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "assembledAt": { "type": "string", "format": "date-time" },
        "lotOrOrderReference": { "type": "string", "minLength": 1 }
      }
    },
    "assembly": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["assembled", "not-assembled", "unknown"] },
        "operator": { "type": "string", "minLength": 1 }
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "model", "calibrationStatus"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "serial": { "type": "string", "minLength": 1 },
          "calibrationStatus": { "enum": ["valid", "expired", "unknown"] },
          "calibrationDue": { "type": "string", "format": "date-time" }
        }
      }
    },
    "conditions": { "type": "object", "additionalProperties": true },
    "testItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "procedure", "observed", "expected", "pass", "uncertainty"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^test:[A-Za-z0-9._:-]+$" },
          "procedure": { "type": "string", "minLength": 1 },
          "observed": {},
          "expected": {},
          "pass": { "type": "boolean" },
          "uncertainty": { "type": "string", "minLength": 1 },
          "artifactHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "mode", "toolVersion", "inputHash"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["real", "simulated", "pending"] },
        "toolVersion": { "type": "string", "minLength": 1 },
        "inputHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "uncertainty": { "type": "string", "minLength": 1 }
      }
    }
  }
}
