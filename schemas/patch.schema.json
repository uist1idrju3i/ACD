{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acd.example.invalid/schemas/patch.schema.json",
  "title": "ACD Patch Envelope",
  "type": "object",
  "required": ["patchId", "baseRevision", "resultRevision", "operations", "createdAt"],
  "properties": {
    "patchId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$" },
    "baseRevision": { "type": "integer", "minimum": 0 },
    "resultRevision": { "type": "integer", "minimum": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op", "path"],
        "properties": {
          "op": { "type": "string", "enum": ["add", "remove", "replace", "test"] },
          "path": { "type": "string", "pattern": "^(/([^/~]|~[01])*)*$" },
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string" },
    "verificationResultIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$" }
    }
  },
  "additionalProperties": false
}
